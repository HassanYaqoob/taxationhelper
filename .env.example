# Copy to .env and change every value marked CHANGE.

# SQL Server "sa" password: at least 8 characters with upper, lower, digit and symbol.
SQL_SA_PASSWORD=CHANGE_Str0ng!Passw0rd
SQL_DATABASE=Kira
# Developer or Express are free. Use your licensed edition in production.
SQL_EDITION=Developer
SQL_PORT=1433

# Signs the 15-minute access tokens. At least 32 random characters.
# Generate one with:  openssl rand -base64 48
JWT_KEY=CHANGE_ME_to_a_long_random_secret_at_least_32_chars

# Optional. Without it Kira still imports CSV statements and you categorise by hand.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Loads the demo company and users (password Demo12345!). Turn off for real data.
SEED_DEMO=true

# true when the site is served over HTTPS (required for the sign-in cookie on a real domain).
# Leave false only for http://localhost or an internal test server without TLS.
SECURE_COOKIES=false

EXPOSE_API_DOCS=false
API_ENVIRONMENT=Production
API_PORT=5080
WEB_PORT=8080
