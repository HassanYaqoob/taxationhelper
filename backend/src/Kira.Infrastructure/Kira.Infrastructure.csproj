<Project Sdk="Microsoft.NET.Sdk">
  <!-- SQL Server persistence (PostgreSQL optional for test servers), AI client, file and Excel handling, password hashing. -->
  <ItemGroup>
    <ProjectReference Include="..\Kira.Application\Kira.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <!-- Optional: lets a test server without SQL Server run on PostgreSQL (Database:Provider = Postgres). -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="ClosedXML" />
  </ItemGroup>
</Project>
